{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["dom-webcodecs"],
    "typeRoots": ["../node_modules/@types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": { "@seyd/core": ["../src/index.ts"] }
  },
  "include": ["*.ts"]
}
