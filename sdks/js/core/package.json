{
  "name": "@seyd/core",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seyd-io/seyd.git",
    "directory": "sdks/js/core"
  },
  "description": "Seyd pilot SDK core: WebTransport P2P, FEC reassembly, WebCodecs decode, control channel",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/dom-webcodecs": "^0.1.13",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
