# OS
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Node
node_modules/
npm-debug.log*

# Build artifact: deploy.sh copies packages/pilot/ here so the image can serve
# it, and removes it on exit. Ignored in case that trap doesn't fire.
packages/signal/pilot/

# TLS certs generated at runtime (packages/agent/cert.py)
*.pem
*.key
*.crt

# Local secrets — camera credentials etc. Never committed.
# See DEMO.md: the camera password must not appear in agent CLI args.
.env.local

# Editor
.vscode/
.idea/

# Local Claude Code settings (machine-specific)
.claude/settings.local.json

# Logs
*.log

# Rust
target/

# JS build output
dist/

# local robot identities
.seyd-sim.key
examples/demo-robot/.robot.key
