// One frame's path from camera to canvas (PLAN.md §2.8 "Figures"). Inline SVG
// on the design tokens (docs/design.md §6), rendered inside <Figure>. Facts:
// CLAUDE.md "No transcoding in Seyd" and "Whole frame or nothing",
// docs/protocol/chunks.md, docs/adr/0005-presentation-pacing.md.
---
<svg viewBox="0 0 660 252" role="img" aria-label="One frame's path. On the robot: the camera's already-encoded frame is depacketised from RTP or RTSP (seydd only), admitted whole or not at all, split into data chunks with parity chunks, and given a wire v2 header per chunk. Over the internet, direct, encrypted, QUIC, never decoded or re-encoded. In the browser: reassembled by frame id, repaired from parity, paced on the capture clock, decoded with WebCodecs, painted to a canvas.">
  <defs><marker id="fig-pipeline-ar" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="currentColor"/></marker></defs>

  <text class="lbl" x="12" y="12">ROBOT · seydd or the SDK</text>
  <g fill="none" stroke="currentColor" stroke-opacity=".6">
    <rect x="12" y="20" width="116" height="62" rx="6"/>
    <rect x="142" y="20" width="116" height="62" rx="6"/>
    <rect x="272" y="20" width="116" height="62" rx="6"/>
    <rect x="402" y="20" width="116" height="62" rx="6"/>
    <rect x="532" y="20" width="116" height="62" rx="6"/>
  </g>
  <text class="node" x="70" y="43" text-anchor="middle">Camera</text>
  <text class="sub" x="70" y="60" text-anchor="middle">already encoded</text>
  <text class="sub" x="70" y="73" text-anchor="middle">H.264 · H.265</text>
  <text class="node" x="200" y="43" text-anchor="middle">Depacketise</text>
  <text class="sub" x="200" y="60" text-anchor="middle">RTP or RTSP</text>
  <text class="sub" x="200" y="73" text-anchor="middle">seydd only</text>
  <text class="node" x="330" y="43" text-anchor="middle">Admit</text>
  <text class="sub" x="330" y="60" text-anchor="middle">whole frame</text>
  <text class="sub" x="330" y="73" text-anchor="middle">or nothing</text>
  <text class="node" x="460" y="43" text-anchor="middle">Chunk + FEC</text>
  <text class="sub" x="460" y="60" text-anchor="middle">n data chunks</text>
  <text class="sub" x="460" y="73" text-anchor="middle">k parity chunks</text>
  <text class="node" x="590" y="43" text-anchor="middle">Wire header</text>
  <text class="sub" x="590" y="60" text-anchor="middle">v2, every chunk</text>
  <text class="sub" x="590" y="73" text-anchor="middle">id · capture ts</text>
  <g stroke="currentColor" stroke-opacity=".6">
    <line x1="129" y1="51" x2="141" y2="51" marker-end="url(#fig-pipeline-ar)"/>
    <line x1="259" y1="51" x2="271" y2="51" marker-end="url(#fig-pipeline-ar)"/>
    <line x1="389" y1="51" x2="401" y2="51" marker-end="url(#fig-pipeline-ar)"/>
    <line x1="519" y1="51" x2="531" y2="51" marker-end="url(#fig-pipeline-ar)"/>
  </g>

  <line x1="590" y1="83" x2="590" y2="109" stroke="var(--seyd-accent)" stroke-width="2" marker-end="url(#fig-pipeline-ar)" style="color: var(--seyd-accent)"/>
  <rect x="12" y="110" width="636" height="38" rx="6" fill="var(--seyd-accent-bg)" stroke="var(--seyd-accent)" stroke-dasharray="4 3"/>
  <text x="330" y="127" text-anchor="middle" font-size="11.5" font-weight="600" fill="var(--seyd-accent)">the internet · direct · encrypted · QUIC</text>
  <text class="lbl" x="330" y="142" text-anchor="middle">never decoded or re-encoded in between: the agent forwards encoded bytes</text>
  <line x1="70" y1="149" x2="70" y2="177" stroke="var(--seyd-accent)" stroke-width="2" marker-end="url(#fig-pipeline-ar)" style="color: var(--seyd-accent)"/>

  <text class="lbl" x="100" y="170">BROWSER · @seyd/core in a worker</text>
  <g fill="none" stroke="currentColor" stroke-opacity=".6">
    <rect x="12" y="178" width="116" height="62" rx="6"/>
    <rect x="142" y="178" width="116" height="62" rx="6"/>
    <rect x="272" y="178" width="116" height="62" rx="6"/>
    <rect x="402" y="178" width="116" height="62" rx="6"/>
    <rect x="532" y="178" width="116" height="62" rx="6"/>
  </g>
  <text class="node" x="70" y="201" text-anchor="middle">Reassemble</text>
  <text class="sub" x="70" y="218" text-anchor="middle">chunks by</text>
  <text class="sub" x="70" y="231" text-anchor="middle">frame id</text>
  <text class="node" x="200" y="201" text-anchor="middle">Repair</text>
  <text class="sub" x="200" y="218" text-anchor="middle">from parity</text>
  <text class="sub" x="200" y="231" text-anchor="middle">if chunks lost</text>
  <text class="node" x="330" y="201" text-anchor="middle">Pace</text>
  <text class="sub" x="330" y="218" text-anchor="middle">capture clock</text>
  <text class="sub" x="330" y="231" text-anchor="middle">+ profile delay</text>
  <text class="node" x="460" y="201" text-anchor="middle">Decode</text>
  <text class="sub" x="460" y="218" text-anchor="middle">WebCodecs</text>
  <text class="sub" x="460" y="231" text-anchor="middle">VideoDecoder</text>
  <text class="node" x="590" y="201" text-anchor="middle">Canvas</text>
  <text class="sub" x="590" y="218" text-anchor="middle">OffscreenCanvas</text>
  <text class="sub" x="590" y="231" text-anchor="middle">on the glass</text>
  <g stroke="currentColor" stroke-opacity=".6">
    <line x1="129" y1="209" x2="141" y2="209" marker-end="url(#fig-pipeline-ar)"/>
    <line x1="259" y1="209" x2="271" y2="209" marker-end="url(#fig-pipeline-ar)"/>
    <line x1="389" y1="209" x2="401" y2="209" marker-end="url(#fig-pipeline-ar)"/>
    <line x1="519" y1="209" x2="531" y2="209" marker-end="url(#fig-pipeline-ar)"/>
  </g>
</svg>
