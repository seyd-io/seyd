  <line x1="422" y1="80" x2="504" y2="80" stroke="currentColor" stroke-opacity=".5" stroke-dasharray="4 4" marker-start="url(#fig-daemon-ar)" marker-end="url(#fig-daemon-ar)"/>
  <text class="lbl" x="463" y="72" text-anchor="middle">WSS</text>
  <text class="lbl" x="463" y="96" text-anchor="middle">signalling</text>

  <rect x="506" y="220" width="148" height="56" rx="6" fill="none" stroke="currentColor" stroke-opacity=".6"/>
